############################################################
# Self-hosted Baserow on Dokploy — production env for
# baserow.veedoo.dev on a 6 GB RAM budget (shared server).
#
# Paste this entire file into the Dokploy "Environment" tab.
#
# IMPORTANT: Do NOT add `KEY=` lines with empty values for the
# optional vars. Baserow has many `int(os.getenv("X", default))`
# calls — if Dokploy injects KEY="", int("") raises ValueError
# and the backend crashes. To "unset" an optional knob, COMMENT
# IT OUT or remove the line entirely. The compose file uses
# bare-key passthrough so a missing var is correctly omitted
# from the container env.
#
# Pin the image tag: `latest` will pull a new major on every
# redeploy.  Tags: https://hub.docker.com/r/baserow/baserow/tags
############################################################
BASEROW_VERSION=2.2.2

# Used as a prefix for every container name so multiple Baserow
# stacks can live on the same Dokploy server without clashing.
CONTAINER_PREFIX=baserow

############################################################
# REQUIRED SECRETS — generate a fresh value for each before deploy.
# Do NOT commit real values; fill these in only in Dokploy's env tab.
#   tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c50   (Django keys)
#   openssl rand -hex 24                            (DB / Redis passwords)
############################################################
SECRET_KEY=you-need-to-generate-this-value
BASEROW_JWT_SIGNING_KEY=you-need-to-generate-this-value
DATABASE_PASSWORD=you-need-to-generate-this-value
REDIS_PASSWORD=you-need-to-generate-this-value

############################################################
# Public URL (must include the scheme)
############################################################
BASEROW_PUBLIC_URL=https://baserow.veedoo.dev
# Trust X-Forwarded-Proto from Traefik so Django emits https:// links
BASEROW_ENABLE_SECURE_PROXY_SSL_HEADER=true

############################################################
# Caddy (internal reverse proxy)
# Plain HTTP — Dokploy/Traefik terminates TLS in front of it.
############################################################
BASEROW_CADDY_ADDRESSES=:80

############################################################
# Database — bundled Postgres 15 + pgvector
############################################################
DATABASE_USER=baserow
DATABASE_NAME=baserow
DATABASE_HOST=db
DATABASE_PORT=5432
# External Postgres? Uncomment ONE line below with a real URL.
# Do NOT leave it set to an empty string — Baserow crashes on that.
# DATABASE_URL=postgresql://user:pass@host:5432/db

## Postgres tuning — sized for the 6 GB stack budget on a shared host.
## DB container ceiling is 1.28 GB; shared_buffers ~25% of that.
PG_SHM_SIZE=384mb
PG_SHARED_BUFFERS=320MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=96MB
PG_MAX_CONNECTIONS=150
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200

############################################################
# Redis — bundled redis:6 (cache + Celery broker)
############################################################
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PROTOCOL=redis
# External Redis? Uncomment with a real URL. Empty = crash.
# REDIS_URL=redis://:password@host:6379/0
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

############################################################
# Email / SMTP — Mailjet (port 587 STARTTLS)
# Sender: "baserow veedoo" <support@veedoo.io>
#
# IMPORTANT — Baserow boolean trap:
# Baserow evaluates these flags with `bool(os.getenv("X", ""))`, and in
# Python `bool("False") == True` because any non-empty string is truthy.
# To DISABLE one of these flags you must OMIT the variable entirely —
# do NOT set it to `False` or `0`, that turns it ON.
#
# We're on Mailjet 587 (STARTTLS) so USE_TLS is on and USE_SSL is omitted.
# For implicit-TLS on 465, OMIT EMAIL_SMTP_USE_TLS and SET EMAIL_SMTP_USE_SSL=True.
############################################################
EMAIL_SMTP=True
EMAIL_SMTP_HOST=in-v3.mailjet.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_TLS=True
# EMAIL_SMTP_USE_SSL=True    # only for port 465 / implicit TLS; never set both
EMAIL_SMTP_USER=you-need-to-set-this-value
EMAIL_SMTP_PASSWORD=you-need-to-set-this-value
FROM_EMAIL=baserow veedoo <support@veedoo.io>

############################################################
# Workers & concurrency — sized for a 6 GB stack budget
############################################################
# Backend gunicorn workers (now have ~1.6 GB to play with)
BASEROW_AMOUNT_OF_GUNICORN_WORKERS=3
# 2 threads per celery worker
BASEROW_AMOUNT_OF_WORKERS=2
# With 6 GB we have room to run a dedicated export worker again, so
# RUN_MINIMAL is off. NOTE: the fused-mode shortcut ONLY engages when
# BASEROW_RUN_MINIMAL=true AND BASEROW_AMOUNT_OF_WORKERS=1 — leaving
# this true with WORKERS=2 (like we had) would start the real export
# worker process anyway, then OOM at the small 128 MB cap.
BASEROW_RUN_MINIMAL=false

############################################################
# API limits
############################################################
BASEROW_ROW_PAGE_SIZE_LIMIT=200
BATCH_ROWS_SIZE_LIMIT=200
BASEROW_FILE_UPLOAD_SIZE_LIMIT_MB=1024
BASEROW_MAX_IMPORT_FILE_SIZE_MB=512

############################################################
# Token lifetimes
############################################################
BASEROW_ACCESS_TOKEN_LIFETIME_MINUTES=10
BASEROW_REFRESH_TOKEN_LIFETIME_HOURS=168

############################################################
# Webhooks
#
# IMPORTANT — same boolean trap as SMTP: Baserow uses
# `bool(os.getenv("BASEROW_WEBHOOKS_ALLOW_PRIVATE_ADDRESS", False))`,
# so any non-empty value (including "false") turns it ON. To keep
# private-address webhooks OFF, OMIT the variable entirely.
# To turn it ON, set it to anything non-empty (e.g. =true).
############################################################
# BASEROW_WEBHOOKS_ALLOW_PRIVATE_ADDRESS=true
BASEROW_WEBHOOKS_MAX_RETRIES_PER_CALL=8

############################################################
# Startup behaviour
############################################################
MIGRATE_ON_STARTUP=true
SYNC_TEMPLATES_ON_STARTUP=true
BASEROW_TRIGGER_SYNC_TEMPLATES_AFTER_MIGRATION=true

############################################################
# Logging
############################################################
BASEROW_BACKEND_DEBUG=false
BASEROW_BACKEND_LOG_LEVEL=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

############################################################
# Per-container memory policy.
#
# Every container is capped at a 4 GB hard ceiling (Docker SIGKILLs
# on overshoot) but otherwise free to grow as needed — no reservations,
# no fixed per-service budget. The cap is a safety net against a single
# runaway process eating the whole shared host.
#
# Raise to 8g or remove the ceiling entirely if a workload legitimately
# needs more; lower it if you want a tighter per-app envelope.
############################################################
CADDY_MEM_LIMIT=4g
BACKEND_MEM_LIMIT=4g
WEB_FRONTEND_MEM_LIMIT=4g
CELERY_MEM_LIMIT=4g
CELERY_EXPORT_MEM_LIMIT=4g
CELERY_BEAT_MEM_LIMIT=4g
DB_MEM_LIMIT=4g
REDIS_MEM_LIMIT=4g

############################################################
# UI / support toggles
############################################################
# Disable the in-app support widget for a private deployment
BASEROW_DISABLE_SUPPORT=true

############################################################
# Misc
############################################################
BASEROW_DEPLOYMENT_ENV=dokploy

############################################################
# ─── Everything below is OPTIONAL ────────────────────────
# Uncomment a key + give it a real value to enable.
# DO NOT leave any of these as `KEY=` blank — Baserow's
# `int(os.getenv("X", default))` calls will crash on empty.
############################################################

# Additional hostnames (comma-separated)
# BASEROW_EXTRA_PUBLIC_URLS=https://baserow-alt.veedoo.io
# BASEROW_EXTRA_ALLOWED_HOSTS=alt.veedoo.io
# BASEROW_DISABLE_PUBLIC_URL_CHECK=false

# Limits / throttling
# INITIAL_TABLE_DATA_LIMIT=
# BASEROW_UNIQUE_ROW_VALUES_SIZE_LIMIT=
# BASEROW_MAX_CONCURRENT_USER_REQUESTS=-1
# BASEROW_CONCURRENT_USER_REQUESTS_THROTTLE_TIMEOUT=180
# BASEROW_SEND_VERIFY_EMAIL_RATE_LIMIT=10/h

# Optional: S3-compatible object storage for uploaded files.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=

# Optional: AI / Generative integrations.
# OPENAI_API_KEY=
# BASEROW_OPENAI_API_KEY=
# BASEROW_OPENAI_MODELS=gpt-4o,gpt-4o-mini
# BASEROW_ANTHROPIC_API_KEY=
# BASEROW_ANTHROPIC_MODELS=claude-opus-4-7,claude-sonnet-4-6
# BASEROW_MISTRAL_API_KEY=
# BASEROW_MISTRAL_MODELS=
# BASEROW_OLLAMA_HOST=
# BASEROW_OLLAMA_MODELS=

# Optional: telemetry / error tracking
# SENTRY_DSN=
# SENTRY_BACKEND_DSN=
# BASEROW_ENABLE_OTEL=false
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_HOST=https://app.posthog.com

# Optional: feature flags / extensions
# FEATURE_FLAGS=
# ADDITIONAL_APPS=
# ADDITIONAL_MODULES=
# BASEROW_DISABLE_GOOGLE_DOCS_FILE_PREVIEW=false
