############################################################
# Self-hosted Baserow — Dokploy environment file
#
# Pin this image tag in production: `latest` will pull a new
# major on every redeploy.  See https://hub.docker.com/r/baserow/baserow/tags
############################################################
BASEROW_VERSION=2.2.2

# Used as a prefix for every container name so multiple Baserow
# stacks can live on the same Dokploy server without clashing.
CONTAINER_PREFIX=baserow

############################################################
# REQUIRED SECRETS — generate before first deploy
# tr -dc 'a-z0-9' < /dev/urandom | head -c50   (or)   openssl rand -hex 32
############################################################
SECRET_KEY=you-need-to-generate-this-value
# Recommended — separate signing key for JWT auth.  Defaults to SECRET_KEY
# if left blank, but rotating SECRET_KEY then invalidates every session.
BASEROW_JWT_SIGNING_KEY=you-need-to-generate-this-value
DATABASE_PASSWORD=you-need-to-generate-this-value
REDIS_PASSWORD=you-need-to-generate-this-value

############################################################
# Public URL — must include http:// or https://
# Update after you add the Dokploy domain (Step 5 of the guide).
############################################################
BASEROW_PUBLIC_URL=https://baserow.example.com
# Comma-separated list of other URLs that should also resolve to this instance
BASEROW_EXTRA_PUBLIC_URLS=
# Required when Dokploy/Traefik terminates TLS in front of Caddy so Django
# trusts the X-Forwarded-Proto header and emits https:// links.
BASEROW_ENABLE_SECURE_PROXY_SSL_HEADER=true
# Comma-separated extra hosts that Django's ALLOWED_HOSTS will accept.
# Leave blank unless you proxy through several hostnames.
BASEROW_EXTRA_ALLOWED_HOSTS=

############################################################
# Caddy (internal reverse proxy)
# Dokploy/Traefik fronts this, so Caddy stays on plain HTTP.
############################################################
BASEROW_CADDY_ADDRESSES=:80

############################################################
# Database — bundled Postgres 15 + pgvector
############################################################
DATABASE_USER=baserow
DATABASE_NAME=baserow
DATABASE_HOST=db
DATABASE_PORT=5432
# DATABASE_URL=    # set this instead if pointing at an external Postgres

## Postgres tuning — tune for your Dokploy server
PG_SHM_SIZE=512mb
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=200
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200

############################################################
# Redis — bundled redis:6
############################################################
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PROTOCOL=redis
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

############################################################
# Email / SMTP — REQUIRED for sign-up confirmation,
# password reset, workspace invitations, and notifications.
#
# Set EMAIL_SMTP=True to enable.  For Gmail / Workspace use
# port 587 + USE_TLS=True; for SES / Mailgun / Postmark with
# port 465 use USE_SSL=True instead.
############################################################
EMAIL_SMTP=True
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_TLS=True
EMAIL_SMTP_USE_SSL=False
EMAIL_SMTP_USER=postmaster@example.com
EMAIL_SMTP_PASSWORD=you-need-to-set-this-value
FROM_EMAIL=baserow@example.com

############################################################
# Workers & concurrency
############################################################
# Gunicorn HTTP workers — leave blank to let Baserow autodetect
BASEROW_AMOUNT_OF_GUNICORN_WORKERS=
# Celery worker concurrency — defaults to host CPU count
BASEROW_AMOUNT_OF_WORKERS=
# Set to true on small servers (<4GB RAM) to merge export + normal queues
BASEROW_RUN_MINIMAL=false

############################################################
# Limits — bump for power users / heavier workloads
############################################################
BASEROW_ROW_PAGE_SIZE_LIMIT=200
BATCH_ROWS_SIZE_LIMIT=200
INITIAL_TABLE_DATA_LIMIT=
BASEROW_FILE_UPLOAD_SIZE_LIMIT_MB=1024
BASEROW_MAX_IMPORT_FILE_SIZE_MB=512

############################################################
# Token lifetimes
############################################################
BASEROW_ACCESS_TOKEN_LIFETIME_MINUTES=10
BASEROW_REFRESH_TOKEN_LIFETIME_HOURS=168

############################################################
# Rate limiting (anti-abuse)
############################################################
BASEROW_MAX_CONCURRENT_USER_REQUESTS=-1
BASEROW_CONCURRENT_USER_REQUESTS_THROTTLE_TIMEOUT=
BASEROW_SEND_VERIFY_EMAIL_RATE_LIMIT=

############################################################
# Webhooks
# Set ALLOW_PRIVATE_ADDRESS=true if you need to hit other
# Dokploy services on the same network from a webhook.
############################################################
BASEROW_WEBHOOKS_ALLOW_PRIVATE_ADDRESS=false
BASEROW_WEBHOOKS_MAX_RETRIES_PER_CALL=8

############################################################
# Startup behaviour
############################################################
MIGRATE_ON_STARTUP=true
SYNC_TEMPLATES_ON_STARTUP=true
BASEROW_TRIGGER_SYNC_TEMPLATES_AFTER_MIGRATION=true

############################################################
# Logging
############################################################
BASEROW_BACKEND_DEBUG=false
BASEROW_BACKEND_LOG_LEVEL=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

############################################################
# Optional: S3-compatible object storage for uploaded files
# Leave blank to keep files on the local `media` volume.
############################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

############################################################
# Optional: AI / Generative integrations
# Each block is independent — enable only what you need.
############################################################
# OPENAI_API_KEY=
# BASEROW_OPENAI_API_KEY=
# BASEROW_OPENAI_MODELS=gpt-4o,gpt-4o-mini
# BASEROW_ANTHROPIC_API_KEY=
# BASEROW_ANTHROPIC_MODELS=claude-opus-4-7,claude-sonnet-4-6
# BASEROW_MISTRAL_API_KEY=
# BASEROW_MISTRAL_MODELS=
# BASEROW_OLLAMA_HOST=
# BASEROW_OLLAMA_MODELS=

############################################################
# Optional: telemetry / error tracking
############################################################
SENTRY_DSN=
SENTRY_BACKEND_DSN=
BASEROW_ENABLE_OTEL=false
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=

############################################################
# Optional: support widget & Google Docs preview off-switch
# Toggle the support widget off for private deployments.
############################################################
BASEROW_DISABLE_GOOGLE_DOCS_FILE_PREVIEW=false
BASEROW_DISABLE_SUPPORT=false

############################################################
# Misc
############################################################
FEATURE_FLAGS=
ADDITIONAL_APPS=
ADDITIONAL_MODULES=
BASEROW_DEPLOYMENT_ENV=dokploy
