# Trigger.dev Webapp Environment Variables for Dokploy Stack (External Databases)
# ================================================================================
# Standalone template: paste this into the Dokploy environment variables section
# along with trigger-webapp-docker-compose.yml
#
# Deploy as Dokploy "Stack" type for Docker Swarm with replicas.
# Databases are EXTERNAL on a separate server — deploy trigger-dbs compose FIRST.
# Shared secrets below MUST match trigger-dbs.env values.
#
# IMPORTANT: Set TRIGGER_REPLICAS=1 for first deploy, get worker token, then scale up.
#
# Generate secrets with: openssl rand -hex 32
# EXCEPTION: ENCRYPTION_KEY needs: openssl rand -hex 16 (exactly 32 hex chars)

# ============================================
# SWARM / REPLICAS
# ============================================

# Number of trigger app replicas (set to 1 for first deploy, scale up after getting worker token)
TRIGGER_REPLICAS=1

# NFS server IP for shared volume (manager node IP — where NFS server runs)
# Replicas on any Swarm node mount this NFS share for the bootstrap worker token.
# See server-setup-webapp.md § NFS for setup instructions.
# Your Swarm manager node's IP address
NFS_SERVER_IP=you-need-to-set-this-value

# ============================================
# DATABASE SERVER CONNECTION
# ============================================
# Public IP or hostname of your dedicated DB server
# All database services (postgres, redis, clickhouse, electric, minio) run on this host
DB_HOST=you-need-to-set-this-value

# ============================================
# DOMAIN CONFIGURATION
# ============================================
# After deploy, add domains in Dokploy UI:
#   - trigger service -> TRIGGER_DOMAIN (port 3000, HTTPS)
#   - registry service -> REGISTRY_DOMAIN (port 5000, HTTPS)
# Then set these env vars to match and redeploy.

TRIGGER_DOMAIN=trigger.example.com
REGISTRY_DOMAIN=trigger-registry.example.com

# ============================================
# SHARED SECRETS (MUST match trigger-dbs.env)
# If you regenerate these, update trigger-dbs.env too!
# ============================================

# Generate with: openssl rand -hex 32 — MUST match trigger-dbs.env
POSTGRES_PASSWORD=you-need-to-generate-this-value
# Generate with: openssl rand -hex 32 — MUST match trigger-dbs.env
CLICKHOUSE_PASSWORD=you-need-to-generate-this-value
# Generate with: openssl rand -hex 32 — MUST match trigger-dbs.env
MINIO_PASSWORD=you-need-to-generate-this-value
# Generate with: openssl rand -hex 32 — MUST match trigger-dbs.env
REDIS_PASSWORD=you-need-to-generate-this-value

# ============================================
# WEBAPP-ONLY SECRETS
# ============================================

# Generate with: openssl rand -hex 32
SESSION_SECRET=you-need-to-generate-this-value
# Generate with: openssl rand -hex 32
MAGIC_LINK_SECRET=you-need-to-generate-this-value
# Generate with: openssl rand -hex 16 (exactly 32 hex chars)
ENCRYPTION_KEY=you-need-to-generate-this-value
# Generate with: openssl rand -hex 32
MANAGED_WORKER_SECRET=you-need-to-generate-this-value
# Generate with: openssl rand -hex 32
REGISTRY_PASSWORD=you-need-to-generate-this-value

# ============================================
# DATABASE (name only — used in connection URL construction)
# ============================================

POSTGRES_DB=trigger

# ============================================
# REGISTRY
# ============================================

REGISTRY_USERNAME=trigger
REGISTRY_NAMESPACE=trigger

# ============================================
# MINIO (Object Storage — credentials for connection URL)
# ============================================

MINIO_ROOT_USER=admin

# ============================================
# CLICKHOUSE (credentials for connection URL)
# ============================================

CLICKHOUSE_ADMIN_USER=default

# ============================================
# NODE.JS MEMORY (per replica — single Node.js process)
# ============================================

NODE_MAX_OLD_SPACE_SIZE=4096

# ============================================
# EMAIL CONFIGURATION (Optional — SMTP)
# Required for magic link login and alert emails
# ============================================

# SMTP_USER=you-need-to-set-this-value
# SMTP_PASSWORD=you-need-to-set-this-value

# ============================================
# SLACK INTEGRATION (Optional)
# Create app at https://api.slack.com/apps
# Required scopes: chat:write, channels:read
# ============================================

# ORG_SLACK_INTEGRATION_CLIENT_ID=
# ORG_SLACK_INTEGRATION_CLIENT_SECRET=

# ============================================
# ADMIN AUTO-PROMOTION (Optional)
# Users matching this regex become admins on signup
# Examples: ".*@yourcompany\.com" or "admin@example\.com"
# ============================================

# ADMIN_EMAILS=.*@yourcompany\.com

# ============================================================
# SWARM DEPLOY RESOURCE LIMITS
# These are used directly in the compose deploy section.
# Adjust based on your Swarm node size.
# ============================================================

# --- Trigger App Resources (per replica, single Node.js process) ---
# Active: 8 vCPU / 16GB node — 1 replica for first deploy, then 2 replicas
# 2 replicas: 2×6G + 1G registry = 13G, leaves 3G for OS/Docker
TRIGGER_CPUS=3
TRIGGER_MEMORY=6G
TRIGGER_CPUS_RESERVED=1
TRIGGER_MEMORY_RESERVED=3G

# --- 4 vCPU / 16GB node (2 replicas) ---
# TRIGGER_REPLICAS=2
# TRIGGER_CPUS=1.5
# TRIGGER_MEMORY=6G
# TRIGGER_CPUS_RESERVED=1
# TRIGGER_MEMORY_RESERVED=3G

# --- 8 vCPU / 32GB node (3 replicas) ---
# TRIGGER_REPLICAS=3
# TRIGGER_CPUS=2
# TRIGGER_MEMORY=5G
# TRIGGER_CPUS_RESERVED=1
# TRIGGER_MEMORY_RESERVED=2G

# --- 16 vCPU / 64GB node (6 replicas) ---
# TRIGGER_REPLICAS=6
# TRIGGER_CPUS=2
# TRIGGER_MEMORY=8G
# TRIGGER_CPUS_RESERVED=1
# TRIGGER_MEMORY_RESERVED=4G
