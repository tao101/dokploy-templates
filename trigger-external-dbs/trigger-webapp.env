# Trigger.dev Webapp Environment Variables for Dokploy Stack (External Databases)
# ================================================================================
# Standalone template: paste this into the Dokploy environment variables section
# along with trigger-webapp-docker-compose.yml
#
# Deploy as Dokploy "Stack" type for Docker Swarm with replicas.
# Databases are EXTERNAL — deploy trigger-dbs compose FIRST.
# Shared secrets below MUST match trigger-dbs.env values.
#
# IMPORTANT: Set TRIGGER_REPLICAS=1 for first deploy, get worker token, then scale up.
#
# Generate secrets with: openssl rand -base64 32
# EXCEPTION: ENCRYPTION_KEY needs: openssl rand -hex 16 (exactly 32 hex chars)

# ============================================
# SWARM / REPLICAS
# ============================================

# Number of trigger app replicas (set to 1 for first deploy, scale up after getting worker token)
TRIGGER_REPLICAS=1

# ============================================
# DOMAIN CONFIGURATION
# ============================================
# After deploy, add domains in Dokploy UI:
#   - trigger service -> TRIGGER_DOMAIN (port 3000, HTTPS)
#   - registry service -> REGISTRY_DOMAIN (port 5000, HTTPS)
# Then set these env vars to match and redeploy.

TRIGGER_DOMAIN=trigger.yourdomain.com
REGISTRY_DOMAIN=registry.yourdomain.com

# ============================================
# SHARED SECRETS (MUST match trigger-dbs.env)
# If you regenerate these, update trigger-dbs.env too!
# ============================================

POSTGRES_PASSWORD=lNSnA7xhOL2jkOQ2xndm5xWczdyyLHGNpNCfsrjP80g=
CLICKHOUSE_PASSWORD=DDUkd8TuhAUmyTgQiXaVI87GXBmWkg38Wb0MmHSXQKI=
MINIO_PASSWORD=j+VPhBGb/GbMC1yzkBjgvEEW/uUIyr8Uw7zLnIcG/ds=

# ============================================
# WEBAPP-ONLY SECRETS
# ============================================

SESSION_SECRET=gD+EK87J18cRzkurlP4sEjf9S7y/JQp3cZ9l8DEg/rs=
MAGIC_LINK_SECRET=tlA9dCMYuqBX3o6pI6BRZCnRpfkWt6k2/7sLLrQqpcU=
ENCRYPTION_KEY=e81e67a80a010237f73a92ad607d6599
MANAGED_WORKER_SECRET=RBEQPoMVfHGJ59e2oEw1TPNA9ITm8fzkiDt96gMlRcg=
REGISTRY_PASSWORD=dxoDEXIXaoCUnjgXeycodIDGrhBmNulHZGQQrOd44w4=

# ============================================
# DATABASE (name only — used in connection URL construction)
# ============================================

POSTGRES_DB=trigger

# ============================================
# REGISTRY
# ============================================

REGISTRY_USERNAME=trigger
REGISTRY_NAMESPACE=trigger

# ============================================
# MINIO (Object Storage — credentials for connection URL)
# ============================================

MINIO_ROOT_USER=admin

# ============================================
# CLICKHOUSE (credentials for connection URL)
# ============================================

CLICKHOUSE_ADMIN_USER=default

# ============================================
# NODE.JS MEMORY
# ============================================

NODE_MAX_OLD_SPACE_SIZE=24576

# ============================================
# EMAIL CONFIGURATION (Optional)
# Required for magic link login
# ============================================

# WHITELISTED_EMAILS=
# EMAIL_TRANSPORT=resend
# FROM_EMAIL=noreply@yourdomain.com
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ============================================
# ALERT CONFIGURATION (Optional)
# Alerts reuse the login email settings above (EMAIL_TRANSPORT, FROM_EMAIL, RESEND_API_KEY)
# ============================================

# ============================================
# SLACK INTEGRATION (Optional)
# Create app at https://api.slack.com/apps
# Required scopes: chat:write, channels:read
# ============================================

# ORG_SLACK_INTEGRATION_CLIENT_ID=your-client-id
# ORG_SLACK_INTEGRATION_CLIENT_SECRET=your-client-secret

# ============================================
# ADMIN AUTO-PROMOTION (Optional)
# Users matching this regex become admins on signup
# Examples: ".*@yourcompany\.com" or "admin@example\.com"
# ============================================

# ADMIN_EMAILS=.*@yourcompany\.com

# ============================================================
# SWARM DEPLOY RESOURCE LIMITS
# These are used directly in the compose deploy section.
# Adjust based on your Swarm node size.
# ============================================================

# --- Trigger App Resources (per replica) ---
# For 8 vCPU / 32GB RAM webapp server with 2 replicas:
TRIGGER_CPUS=3
TRIGGER_MEMORY=12G
TRIGGER_CPUS_RESERVED=2
TRIGGER_MEMORY_RESERVED=8G

# --- For single replica on 8 vCPU / 32GB RAM ---
# TRIGGER_CPUS=6
# TRIGGER_MEMORY=24G
# TRIGGER_CPUS_RESERVED=4
# TRIGGER_MEMORY_RESERVED=12G

# --- For 4 vCPU / 8GB RAM nodes ---
# TRIGGER_CPUS=3
# TRIGGER_MEMORY=6G
# TRIGGER_CPUS_RESERVED=1
# TRIGGER_MEMORY_RESERVED=4G
