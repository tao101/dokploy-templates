# Trigger.dev Worker Environment Variables for Dokploy
# ====================================================
# Deploy on each worker server. Get required values from your webapp deployment.
#
# Worker Token (one-time):
#   docker logs <trigger-container> | grep -A15 "Worker Token"

# ============================================
# DOKPLOY SETTINGS
# ============================================

# Container name prefix
CONTAINER_PREFIX=trigger-worker

# ============================================
# REQUIRED: Connection to Webapp
# ============================================

# Webapp URL (the URL where your Trigger.dev webapp is accessible)
TRIGGER_API_URL=https://trigger.yourdomain.com

# Worker token (get from webapp logs after first deploy)
# Run: docker logs <trigger-container> | grep -A15 "Worker Token"
TRIGGER_WORKER_TOKEN=tr_wgt_xxxxxxxxxxxxx

# Must match webapp's MANAGED_WORKER_SECRET
MANAGED_WORKER_SECRET=CHANGE_ME_must_match_webapp

# ============================================
# REQUIRED: Registry Settings
# ============================================

# Registry URL (where your Docker registry is accessible, must use HTTPS)
DOCKER_REGISTRY_URL=https://registry.yourdomain.com

# Registry credentials (must match webapp's REGISTRY_USERNAME and REGISTRY_PASSWORD)
REGISTRY_USERNAME=trigger
REGISTRY_PASSWORD=CHANGE_ME_must_match_webapp

# ============================================
# REQUIRED: Docker Network
# ============================================
# Set to the Dokploy compose network name for this worker.
# Find it after first deploy: docker network ls | grep trigger-worker
# Format is typically: <compose-project-name>_default
# Example: trigger-worker_default

DOCKER_RUNNER_NETWORKS=CHANGE_ME_check_docker_network_ls

# ============================================
# PERFORMANCE TUNING
# ============================================

# Number of parallel job dequeue threads (increase for more throughput)
DEQUEUE_CONSUMER_COUNT=20

# Jobs processed per dequeue cycle
DEQUEUE_RUN_COUNT=30

# Poll interval in milliseconds (lower = faster task pickup, higher CPU)
DEQUEUE_INTERVAL_MS=500

# Minimum consumer count (floor for scaling down)
DEQUEUE_MIN_CONSUMER_COUNT=2

# Idle interval when no work available (ms)
DEQUEUE_IDLE_INTERVAL_MS=3000

# Scaling strategy
DEQUEUE_SCALING_STRATEGY=smooth
DEQUEUE_SCALING_UP_COOLDOWN_MS=10000
DEQUEUE_SCALING_DOWN_COOLDOWN_MS=5000

# Runner snapshot poll interval (seconds)
RUNNER_SNAPSHOT_POLL_INTERVAL_SECONDS=10

# Enforce machine preset resource limits
# 1 = enabled (tasks limited to preset CPU/memory)
# 0 = disabled (faster startup, tasks use available resources)
ENFORCE_MACHINE_PRESETS=1

# Enforce Docker resource limits for machine presets
# true = enabled (tasks limited to preset resources)
# false = disabled (faster startup, no CPU/memory constraints)
DOCKER_ENFORCE_MACHINE_PRESETS=true

# Debug mode (set to 0 for production)
DEBUG=1

# ============================================
# LOGGING SETTINGS
# ============================================

# Send detailed run logs to the Trigger.dev dashboard
SEND_RUN_DEBUG_LOGS=true

# Pretty format logs in container output (useful for debugging)
RUNNER_PRETTY_LOGS=true

# ============================================
# SCALING GUIDE
# ============================================
# For a server with 64 vCPU / 128GB RAM running small-1x tasks:
# - Each small-1x task uses 0.5 vCPU, 0.5GB RAM
# - Theoretical max: ~128 concurrent tasks
# - Recommended (with 20% headroom): ~100 concurrent tasks
#
# Adjust DEQUEUE_CONSUMER_COUNT and DEQUEUE_RUN_COUNT based on:
# - Higher values = more throughput but higher resource usage
# - Lower values = less resource contention

# ============================================================
# RESOURCE LIMITS (Hetzner Cloud NVMe Servers)
# Uncomment ONE section based on your worker server size
# Note: These are for reference — apply via Dokploy UI resource limits
# ============================================================

# --- TIER 1: 4 vCPU, 16GB RAM (NVMe) ---
# SUPERVISOR_CPUS=3
# SUPERVISOR_MEMORY=14G
# SUPERVISOR_CPUS_RESERVED=2
# SUPERVISOR_MEMORY_RESERVED=8G
# DOCKER_PROXY_CPUS=1
# DOCKER_PROXY_MEMORY=1G

# --- TIER 2: 8 vCPU, 32GB RAM (NVMe) ---
# SUPERVISOR_CPUS=6
# SUPERVISOR_MEMORY=28G
# SUPERVISOR_CPUS_RESERVED=4
# SUPERVISOR_MEMORY_RESERVED=16G
# DOCKER_PROXY_CPUS=2
# DOCKER_PROXY_MEMORY=2G

# --- TIER 3: 16 vCPU, 64GB RAM (NVMe) ---
# SUPERVISOR_CPUS=14
# SUPERVISOR_MEMORY=58G
# SUPERVISOR_CPUS_RESERVED=8
# SUPERVISOR_MEMORY_RESERVED=32G
# DOCKER_PROXY_CPUS=2
# DOCKER_PROXY_MEMORY=4G

# --- TIER 4: 32 vCPU, 128GB RAM (NVMe) ---
# SUPERVISOR_CPUS=28
# SUPERVISOR_MEMORY=120G
# SUPERVISOR_CPUS_RESERVED=16
# SUPERVISOR_MEMORY_RESERVED=64G
# DOCKER_PROXY_CPUS=4
# DOCKER_PROXY_MEMORY=6G
