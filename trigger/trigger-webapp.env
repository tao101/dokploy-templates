# ELECTRIC_MEMORY=2G
# MINIO_CPUS=1
# MINIO_MEMORY=2G
# REGISTRY_CPUS=1
# REGISTRY_MEMORY=1G

# --- TIER 3: 16 vCPU, 64GB RAM (NVMe) ---
# TRIGGER_CPUS=8
# TRIGGER_MEMORY=16G
# POSTGRES_CPUS=6
# POSTGRES_MEMORY=24G
# REDIS_CPUS=4
# REDIS_MEMORY=28G
# CLICKHOUSE_CPUS=4
# CLICKHOUSE_MEMORY=8G
# ELECTRIC_CPUS=2
# ELECTRIC_MEMORY=4G
# MINIO_CPUS=2
# MINIO_MEMORY=4G
# REGISTRY_CPUS=2
# REGISTRY_MEMORY=2G

# --- TIER 4: 32 vCPU, 128GB RAM (NVMe) ---
# TRIGGER_CPUS=16
# TRIGGER_MEMORY=32G
# POSTGRES_CPUS=12
# POSTGRES_MEMORY=48G
# REDIS_CPUS=8
# REDIS_MEMORY=56G
# CLICKHOUSE_CPUS=8
# CLICKHOUSE_MEMORY=16G
