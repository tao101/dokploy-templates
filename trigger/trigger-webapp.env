# Trigger.dev Webapp Environment Variables for Dokploy
# ====================================================
# Standalone template: paste this into the Dokploy environment variables section
# along with trigger-webapp-docker-compose.yml
#
# Generate secrets with: openssl rand -base64 32
# EXCEPTION: ENCRYPTION_KEY needs: openssl rand -hex 16 (exactly 32 hex chars)

# ============================================
# DOKPLOY SETTINGS
# ============================================

# Container name prefix (Dokploy uses this for container naming)
CONTAINER_PREFIX=trigger-webapp

# ============================================
# DOMAIN CONFIGURATION
# ============================================
# After deploy, add domains in Dokploy UI:
#   - trigger service -> TRIGGER_DOMAIN (port 3000, HTTPS)
#   - registry service -> REGISTRY_DOMAIN (port 5000, HTTPS)
# Then set these env vars to match and redeploy.

TRIGGER_DOMAIN=trigger.example.com
REGISTRY_DOMAIN=registry.example.com

# ============================================
# SECRETS (MUST CHANGE before production)
# Generate each with: openssl rand -base64 32
# EXCEPTION: ENCRYPTION_KEY needs: openssl rand -hex 16 (exactly 32 hex chars)
# ============================================

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=you-need-to-generate-this-value
# Generate with: openssl rand -base64 32
SESSION_SECRET=you-need-to-generate-this-value
# Generate with: openssl rand -base64 32
MAGIC_LINK_SECRET=you-need-to-generate-this-value
# Generate with: openssl rand -hex 16 (exactly 32 hex chars)
ENCRYPTION_KEY=you-need-to-generate-this-value
# Generate with: openssl rand -base64 32
MANAGED_WORKER_SECRET=you-need-to-generate-this-value
# Generate with: openssl rand -base64 32
REGISTRY_PASSWORD=you-need-to-generate-this-value
# Generate with: openssl rand -base64 32
MINIO_PASSWORD=you-need-to-generate-this-value
# Generate with: openssl rand -base64 32
ELECTRIC_SECRET=you-need-to-generate-this-value
# Generate with: openssl rand -base64 32
CLICKHOUSE_PASSWORD=you-need-to-generate-this-value

# ============================================
# DATABASE
# ============================================

POSTGRES_DB=trigger

# ============================================
# REGISTRY
# ============================================

REGISTRY_USERNAME=trigger
REGISTRY_NAMESPACE=trigger

# ============================================
# MINIO (Object Storage)
# ============================================

MINIO_ROOT_USER=admin

# ============================================
# CLICKHOUSE
# ============================================

CLICKHOUSE_ADMIN_USER=default

# ============================================
# NODE.JS MEMORY
# ============================================

NODE_MAX_OLD_SPACE_SIZE=16384

# ============================================
# EMAIL CONFIGURATION (Optional)
# Required for magic link login
# ============================================

# WHITELISTED_EMAILS=.*@yourcompany\.com
# EMAIL_TRANSPORT=resend
# FROM_EMAIL=noreply@mailer.example.com
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ============================================
# ALERT CONFIGURATION (Optional)
# Alerts reuse the login email settings above (EMAIL_TRANSPORT, FROM_EMAIL, RESEND_API_KEY)
# ============================================

# ============================================
# SLACK INTEGRATION (Optional)
# Create app at https://api.slack.com/apps
# Required scopes: chat:write, channels:read
# ============================================

# ORG_SLACK_INTEGRATION_CLIENT_ID=your-client-id
# ORG_SLACK_INTEGRATION_CLIENT_SECRET=your-client-secret

# ============================================
# ADMIN AUTO-PROMOTION (Optional)
# Users matching this regex become admins on signup
# Examples: ".*@yourcompany\.com" or "admin@example\.com"
# ============================================

# ADMIN_EMAILS=.*@yourcompany\.com

# ============================================
# BACKUP CONFIGURATION (Optional)
# Set BACKUP_ENABLED=true to enable automatic backups
# ============================================

BACKUP_ENABLED=false
BACKUP_S3_PREFIX=trigger

# S3-Compatible Storage (Required when backups are enabled)
# BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
# BACKUP_S3_BUCKET=my-trigger-backups
# BACKUP_S3_ACCESS_KEY_ID=your-access-key
# BACKUP_S3_SECRET_ACCESS_KEY=your-secret-key
# BACKUP_S3_REGION=us-east-1

# PostgreSQL Backup Settings (Optional - defaults shown)
# BACKUP_POSTGRES_SCHEDULE=0 2 * * *
# BACKUP_POSTGRES_KEEP_DAYS=60

# Redis Backup Settings (Optional - defaults shown)
# BACKUP_REDIS_SCHEDULE=0 3 * * *
# BACKUP_REDIS_KEEP_DAYS=60

# ============================================================
# POSTGRESQL TUNING (Hetzner Cloud NVMe Servers)
# Uncomment ONE section based on your server size
# ============================================================

# --- TIER 1: 4 vCPU, 16GB RAM (NVMe) ---
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=12GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=1GB
PG_MAX_CONNECTIONS=1000

# --- TIER 2: 8 vCPU, 32GB RAM (NVMe) ---
# PG_SHARED_BUFFERS=8GB
# PG_EFFECTIVE_CACHE_SIZE=24GB
# PG_WORK_MEM=128MB
# PG_MAINTENANCE_WORK_MEM=2GB
# PG_MAX_CONNECTIONS=1500

# --- TIER 3: 16 vCPU, 64GB RAM (NVMe) ---
# PG_SHARED_BUFFERS=16GB
# PG_EFFECTIVE_CACHE_SIZE=48GB
# PG_WORK_MEM=256MB
# PG_MAINTENANCE_WORK_MEM=4GB
# PG_MAX_CONNECTIONS=2000

# --- TIER 4: 32 vCPU, 128GB RAM (NVMe) ---
# PG_SHARED_BUFFERS=32GB
# PG_EFFECTIVE_CACHE_SIZE=96GB
# PG_WORK_MEM=512MB
# PG_MAINTENANCE_WORK_MEM=8GB
# PG_MAX_CONNECTIONS=3000

# ============================================================
# REDIS TUNING (Hetzner Cloud NVMe Servers)
# Uncomment ONE section based on your server size
# ============================================================

# --- TIER 1: 4 vCPU, 16GB RAM (NVMe) ---
REDIS_MAXMEMORY=6gb
REDIS_IO_THREADS=4

# --- TIER 2: 8 vCPU, 32GB RAM (NVMe) ---
# REDIS_MAXMEMORY=12gb
# REDIS_IO_THREADS=6

# --- TIER 3: 16 vCPU, 64GB RAM (NVMe) ---
# REDIS_MAXMEMORY=24gb
# REDIS_IO_THREADS=8

# --- TIER 4: 32 vCPU, 128GB RAM (NVMe) ---
# REDIS_MAXMEMORY=48gb
# REDIS_IO_THREADS=12

# ============================================================
# CLICKHOUSE TUNING
# FINAL query optimizations enabled by default in compose
# ============================================================

# CH_MAX_THREADS=8
# CH_MARK_CACHE_SIZE=1073741824

# ============================================================
# SERVICE RESOURCE LIMITS (Hetzner Cloud NVMe Servers)
# Uncomment ONE section based on your server size
# Note: These are for reference — apply via Dokploy UI resource limits
# ============================================================

# --- TIER 1: 4 vCPU, 16GB RAM (NVMe) ---
# TRIGGER_CPUS=2
# TRIGGER_MEMORY=4G
# POSTGRES_CPUS=2
# POSTGRES_MEMORY=6G
# REDIS_CPUS=1
# REDIS_MEMORY=7G
# CLICKHOUSE_CPUS=1
# CLICKHOUSE_MEMORY=2G
# ELECTRIC_CPUS=1
# ELECTRIC_MEMORY=1G
# MINIO_CPUS=1
# MINIO_MEMORY=1G
# REGISTRY_CPUS=1
# REGISTRY_MEMORY=512M

# --- TIER 2: 8 vCPU, 32GB RAM (NVMe) ---
# TRIGGER_CPUS=4
# TRIGGER_MEMORY=8G
