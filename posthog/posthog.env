# PostHog Environment Variables for Dokploy
# =========================================
# Paste this into the Dokploy compose service's Environment tab, alongside
# posthog-docker-compose.yml.
#
# Defaults below are tuned for a Hetzner CX43 (8 shared vCPU / 16 GB / 160 GB NVMe)
# running PostHog and nothing else. Other tiers are at the bottom of this file.

# ============================================
# DOKPLOY SETTINGS
# ============================================

# Prefix for container names (docker ps / docker logs readability)
CONTAINER_PREFIX=posthog

# ============================================
# DOMAIN
# ============================================
# After the first deploy, add a domain in the Dokploy UI:
#   Service: proxy   Container Port: 80   HTTPS: on
# Then set this to the same host and redeploy.
POSTHOG_DOMAIN=posthog.example.com

# ============================================
# IMAGE TAGS
# ============================================
# PostHog no longer cuts tagged releases — `latest` is the tip of master, rebuilt
# many times a day. Deploy with `latest` once, confirm the instance is healthy,
# then pin all three to the digests you validated (see DEPLOY-GUIDE.md "Pinning").
# Leaving them floating means every Dokploy redeploy silently upgrades PostHog.
POSTHOG_APP_TAG=latest
POSTHOG_NODE_TAG=latest
POSTHOG_GHCR_TAG=master

# The ghcr.io Rust/Go services are each rebuilt only when their own code changes,
# so they sit at different commits and one shared tag cannot pin them all. Each
# one can be overridden individually; unset, they fall back to POSTHOG_GHCR_TAG.
# Rust services publish `sha-<7-char>` tags; livestream publishes `sha-<40-char>`.
# CAPTURE_TAG=sha-xxxxxxx          # capture, capture-ai, replay-capture
# CAPTURE_LOGS_TAG=sha-xxxxxxx
# FEATURE_FLAGS_TAG=sha-xxxxxxx
# HYPERCACHE_TAG=sha-xxxxxxx
# PERSONHOG_TAG=sha-xxxxxxx        # personhog-router + personhog-replica
# PROPERTY_DEFS_TAG=sha-xxxxxxx
# CYMBAL_TAG=sha-xxxxxxx           # cymbal + cymbal-resolution
# LIVESTREAM_TAG=sha-<full 40-char sha>

# ============================================
# SECRETS (MUST CHANGE before deploying)
# Keep every value unchanged across upgrades.
# ============================================

# Django SECRET_KEY. Also signs internal service calls and livestream JWTs.
# Generate with: openssl rand -hex 32
POSTHOG_SECRET=you-need-to-generate-this-value

# Encrypts stored integration credentials. MUST be exactly 32 hex characters.
# Rotating this makes every saved integration credential unreadable.
# Generate with: openssl rand -hex 16
ENCRYPTION_SALT_KEYS=you-need-to-generate-this-value

# Token for the headless Chromium container, kept separate from POSTHOG_SECRET so
# a compromise of the renderer can't yield Django's signing key.
# Generate with: openssl rand -hex 32
BROWSERLESS_SECRET=you-need-to-generate-this-value

# PostgreSQL password. Upstream hobby ships the published default `posthog`.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=you-need-to-generate-this-value

# MinIO (exports, AI blobs). Upstream ships published defaults here too.
MINIO_ROOT_USER=posthog
# Generate with: openssl rand -hex 16
MINIO_ROOT_PASSWORD=you-need-to-generate-this-value

# ============================================
# TELEMETRY
# ============================================
# 0 = send anonymous usage data to PostHog Cloud (upstream default), 1 = opt out.
OPT_OUT_CAPTURE=0

# ============================================
# SESSION REPLAY
# ============================================
# Blob-backed replay storage (SeaweedFS). Upstream leaves the master switch off
# outside DEBUG even though it wires up every other replay-storage variable.
SESSION_RECORDING_V2_S3_ENABLED=True

# ============================================
# EMAIL (Optional — needed for invites and password resets)
# ============================================
# These seed PostHog's *instance settings* the first time the app boots. Once the
# values are in the database, changing them here has no effect — edit them at
# https://your-domain/instance/settings instead.
# EMAIL_ENABLED=True
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_DEFAULT_FROM=posthog@example.com

# ============================================
# AI FEATURES (Optional)
# ============================================
# PostHog's Max assistant runs on your own key; OpenAI powers SQL/regex assist.
# ANTHROPIC_API_KEY=sk-ant-xxxx
# OPENAI_API_KEY=sk-xxxx

# ============================================================
# TIER: 8 vCPU / 16 GB / 160 GB  (Hetzner CX43) — ACTIVE
# ============================================================
# Container memory limits. These are ceilings, not reservations: they stop one
# service from taking the box down, and they are what ClickHouse and the JVMs
# read to size themselves. Typical steady-state usage is ~12 GB of the 16 GB
# (measured Sep 2026: each Django process is ~1 GB resident, not the ~450 MB it
# used to be, which is why web/worker/temporal-worker are sized as they are).

MEM_CLICKHOUSE=3584M
MEM_DB=2560M
MEM_KAFKA=2560M
MEM_WEB=3072M
MEM_WORKER=2560M
MEM_TEMPORAL_WORKER=1536M
MEM_INGESTION=1024M
MEM_BROWSERLESS=1024M
MEM_PLUGINS=768M
MEM_INGESTION_REPLAY=768M
MEM_REDIS=768M
MEM_TEMPORAL=768M
MEM_SEAWEEDFS=768M
MEM_NODE_SMALL=512M
MEM_OBJECTSTORAGE=512M
MEM_ZOOKEEPER=512M
MEM_CYMBAL=512M
MEM_VALKEY=384M
MEM_RUST=384M
MEM_LIVESTREAM=384M
MEM_CAPTURE=320M
MEM_RUST_SMALL=256M
MEM_PROXY=192M

# --- PostgreSQL ---
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_WAL_SIZE=2GB

# --- ClickHouse (bytes) ---
# Server budget. Keep ~1 GB below MEM_CLICKHOUSE for allocator + thread overhead.
CH_MAX_SERVER_MEMORY=2415919104
CH_MARK_CACHE=536870912
CH_UNCOMPRESSED_CACHE=134217728
CH_MAX_CONCURRENT_QUERIES=40
CH_MAX_THREAD_POOL=2000
CH_THREADS_SOFT_LIMIT=8
CH_QUERY_LOG_TTL_DAYS=3
# Per-query budget; queries spill to disk at the external_* thresholds.
CH_MAX_MEMORY_USAGE=1610612736
CH_EXTERNAL_GROUP_BY=805306368
CH_EXTERNAL_SORT=805306368
CH_MAX_THREADS=4

# --- Redis / Valkey ---
REDIS_MAXMEMORY=512mb
VALKEY_MAXMEMORY=256mb

# --- ZooKeeper ---
ZK_HEAP=256m

# --- Redpanda (Kafka) ---
# Seastar preallocates RP_MEMORY on start, so this is a floor as well as a cap.
RP_SMP=2
RP_MEMORY=2G
# Topic retention. Caps what a stalled consumer can cost the 160 GB disk:
# worst case is roughly (number of topics) x KAFKA_RETENTION_BYTES.
KAFKA_RETENTION_MS=86400000
KAFKA_RETENTION_BYTES=1073741824

# --- Django / Celery / Node ---
# Each Nginx Unit process is a full Django interpreter (~1 GB resident on 2026 master).
WEB_PROCESSES=3
WEB_REQUEST_LIMIT=7500
# Celery forks one Django process per worker and defaults to one per vCPU.
CELERY_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=200
# KB. Restarts a child once it exceeds this, to bound leak growth.
CELERY_MAX_MEMORY_PER_CHILD=400000
CELERY_PREFETCH=1
# Node heap ceilings, in MB.
NODE_HEAP_INGESTION=640
NODE_HEAP_PLUGINS=448
NODE_HEAP_REPLAY=448
NODE_HEAP_SMALL=320

# --- Browserless ---
BROWSERLESS_CONCURRENT=2
BROWSERLESS_TIMEOUT=60000

# ============================================================
# TIER: 8 vCPU / 32 GB  (e.g. Hetzner CCX33 / CPX51)
# Uncomment this block to override the CX43 values above.
# ============================================================
# MEM_CLICKHOUSE=8192M
# MEM_DB=6144M
# MEM_KAFKA=4608M
# MEM_WEB=3072M
# MEM_WORKER=3072M
# MEM_TEMPORAL_WORKER=2048M
