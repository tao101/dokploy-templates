############
# Database connection strings (convenience — copy into your app / ORM)
# NOTE: these are informational; the compose does not consume them. Fill them in
# after you set the secrets/ports below. Replace:
#   <POSTGRES_PASSWORD>  -> the POSTGRES_PASSWORD you set below
#   <POOLER_TENANT_ID>   -> the POOLER_TENANT_ID you set below
#   <DB_HOST>            -> your server IP or a DB hostname (see WARNING)
#
# WARNING: do NOT use a Cloudflare-proxied domain as <DB_HOST> — Cloudflare only
# proxies HTTP/HTTPS (80/443), so the DB ports below are unreachable through it.
# Use the server's IP, or a DNS record set to "DNS only" (grey cloud).
#
#   DIRECT      -> migrations (Prisma/Drizzle), DDL, long-lived sessions. TLS required.
#   SESSION     -> persistent app connections via Supavisor pooler (session mode).
#   TRANSACTION -> serverless / edge / short-lived connections (transaction mode).
############
DATABASE_URL_DIRECT=postgres://postgres:<POSTGRES_PASSWORD>@<DB_HOST>:48215/postgres?sslmode=require
DATABASE_URL_SESSION=postgres://postgres.<POOLER_TENANT_ID>:<POSTGRES_PASSWORD>@<DB_HOST>:5434/postgres
DATABASE_URL_TRANSACTION=postgres://postgres.<POOLER_TENANT_ID>:<POSTGRES_PASSWORD>@<DB_HOST>:6546/postgres


############
# To get a proper working configuration you should at least take a look at:
# - SUPABASE_PUBLIC_URL, API_EXTERNAL_URL should point to your supabase domain with correct http/https scheme
# - SMTP_* are required for auth mail sending
# - ADDITIONAL_REDIRECT_URLS, SITE_URL should point to application using supabase for authentication
#   They are used for redirecting after login/signup and gotrue will check them before sending emails
# - POSTGRES_PORT, POOLER_PROXY_PORT_TRANSACTION should be changed if you are already running other instances of supabase
#
# Supabase uses container names in part of its configuration so it is important to keep them
# This template generates a random prefix for the container names to avoid conflicts
# If you change it you will need to update routes in the vector.yml file in advanced->mounts section
############
CONTAINER_PREFIX=my-supabase

############
# Secrets — YOU MUST FILL THESE IN BEFORE DEPLOYING.
# Each value below is blank with a generation command in the comment above it.
# Generate every one (don't reuse the examples) and never commit real values.
# https://supabase.com/docs/guides/self-hosting/docker#securing-your-services
############

# Your Supabase domain/host (no scheme), e.g. sb.example.com
SUPABASE_HOST=sb.example.com
# Generate: openssl rand -hex 16  (hex-only — base64 breaks URI parsing)
POSTGRES_PASSWORD=
# Generate: openssl rand -hex 20  (min 32 chars)
JWT_SECRET=
# HS256 JWT with role=anon, signed with the JWT_SECRET above.
# Generate at https://supabase.com/docs/guides/self-hosting/docker#api-keys (use the JWT generator with your JWT_SECRET)
ANON_KEY=
# HS256 JWT with role=service_role, signed with the same JWT_SECRET. Generate the same way as ANON_KEY.
SERVICE_ROLE_KEY=
# Studio (dashboard) basic-auth user — pick a non-guessable username, NOT "admin"
DASHBOARD_USERNAME=
# Studio basic-auth password — generate: openssl rand -base64 32  (20+ chars)
DASHBOARD_PASSWORD=
# Generate: openssl rand -hex 32
SECRET_KEY_BASE=
# Generate: openssl rand -hex 16  (must be exactly 32 chars)
VAULT_ENC_KEY=
# Generate: openssl rand -hex 16
PG_META_CRYPTO_KEY=


############
# Database - You can change these to any PostgreSQL database that has logical replication enabled.
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# default user is postgres


############
# PostgreSQL Tuning (conservative defaults — override in env for your hardware)
# These are passed as -c flags to postgres via the compose command
############

## Memory
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_AUTOVACUUM_WORK_MEM=64MB

## WAL & Checkpoints
PG_WAL_BUFFERS=16MB
PG_CHECKPOINT_COMPLETION=0.9
PG_MIN_WAL_SIZE=512MB
PG_MAX_WAL_SIZE=2GB

## NVMe SSD Optimization
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_MAINTENANCE_IO_CONCURRENCY=200

## Connections
PG_MAX_CONNECTIONS=200

## Parallelism
PG_MAX_WORKER_PROCESSES=4
PG_MAX_PARALLEL_WORKERS=4
PG_MAX_PARALLEL_WORKERS_PER_GATHER=2
PG_MAX_PARALLEL_MAINTENANCE_WORKERS=2

## Shared Memory (for /dev/shm)
PG_SHM_SIZE=2g

## Misc
PG_HUGE_PAGES=try
PG_DEFAULT_STATISTICS_TARGET=100


############
# Supavisor -- Database pooler
# NOTE: these are example host ports. Change them if another Postgres/Supavisor
# instance on the same host already uses these ports (Supabase defaults are
# 5432 session / 6543 transaction).
############
POOLER_SESSION_PORT=5434
POOLER_PROXY_PORT_TRANSACTION=6546
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=my-supabase
# Internal metadata pool for Supavisor (NOT the client-facing pool)
POOLER_DB_POOL_SIZE=5

############
# Supavisor Performance Tuning
############
# Kill idle client connections after 5 min (default: 0 = never)
POOLER_CLIENT_IDLE_TIMEOUT=300000
# Detect dead connections faster (default: 60s)
POOLER_CLIENT_HEARTBEAT_INTERVAL=30
# Fail fast if pool is exhausted (default: 60s)
POOLER_POOL_CHECKOUT_TIMEOUT=10000

############
# Direct DB access (for Prisma migrations)
# Obscure high port (not 5432/5435) to dodge mass bot scanners. TLS is enforced
# (ssl=on) and the password is 32 hex chars, so brute-force surface is minimal.
# Connect with: ...@<DB_HOST>:48215/postgres?sslmode=require
############
POSTGRES_DIRECT_PORT=48215


############
# Internal Service DB Pools (explicit connection budget)
# These count against PG max_connections
############
PGRST_DB_POOL=15
PGRST_DB_POOL_TIMEOUT=10
GOTRUE_DB_POOL=15


############
# API Proxy - Configuration for the Kong Reverse proxy.
# Following ports should not be changed for a dokploy config unless you know what you are doing.
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


############
# API - Configuration for PostgREST.
############

PGRST_DB_SCHEMAS=public,storage,graphql_public


############
# Auth - Configuration for the GoTrue authentication server.
############

## General
SITE_URL=https://sb.example.com
ADDITIONAL_REDIRECT_URLS=https://sb.example.com/*
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=https://sb.example.com

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth — configure with your own SMTP provider (SendGrid, SES, Postmark, Mailgun, ...)
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
# Your SMTP server host, e.g. smtp.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Your App
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true


############
# Realtime Scaling
############
RT_MAX_CONCURRENT_USERS=200
RT_MAX_EVENTS_PER_SECOND=500
RT_MAX_JOINS_PER_SECOND=100
RT_MAX_BYTES_PER_SECOND=100000
# Generate: openssl rand -hex 8
REALTIME_DB_ENC_KEY=


############
# Studio - Configuration for the Dashboard
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

STUDIO_PORT=3000
# replace if you intend to use Studio outside of localhost
SUPABASE_PUBLIC_URL=https://sb.example.com

# Enable webp support
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Add your OpenAI API key to enable the Studio SQL Editor AI assistant.
# Replace the placeholder below with your real key (sk-...) in the Dokploy env editor before deploying.
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY


############
# Functions - Configuration for Edge Functions
############
# NOTE: VERIFY_JWT applies to all functions. Per-function VERIFY_JWT is not supported yet.
FUNCTIONS_VERIFY_JWT=false
# Worker memory limit per function invocation (in MB)
FUNCTIONS_WORKER_MEMORY_MB=512
# Worker timeout per function invocation (in ms, 300000 = 5 minutes)
FUNCTIONS_WORKER_TIMEOUT_MS=300000


############
# Logs - Configuration for Logflare
# Please refer to https://supabase.com/docs/reference/self-hosting-analytics/introduction
############

# Generate: openssl rand -hex 16
LOGFLARE_LOGGER_BACKEND_API_KEY=

# Logflare access tokens (replaces LOGFLARE_API_KEY)
# LOGFLARE_PUBLIC_ACCESS_TOKEN MUST equal LOGFLARE_LOGGER_BACKEND_API_KEY above (vector uses it)
LOGFLARE_PUBLIC_ACCESS_TOKEN=
# Generate: openssl rand -hex 16
LOGFLARE_PRIVATE_ACCESS_TOKEN=

############
# Storage
############
# Max upload file size in bytes (1GB = 1073741824)
FILE_SIZE_LIMIT=1073741824

# Docker socket location - this value will differ depending on your OS
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Google Cloud Project details
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER


############
# Docker Log Rotation
############
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
