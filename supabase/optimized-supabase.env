############
# Optimized Supabase Environment for Hetzner CCX33 (8 vCPU, 32GB RAM, NVMe SSD)
#
# Changes from supabase.env:
#   - PostgreSQL tuning parameters added (PG_* vars)
#   - Supavisor pool sized for 800 connections
#   - POOLER_TENANT_ID changed from placeholder
#   - PostgREST and GoTrue pool sizes made explicit
#   - Realtime scaling parameters added
#   - Realtime DB_ENC_KEY moved to env var
#   - Docker log rotation config added
############
CONTAINER_PREFIX=supabase-prod-test-1

############
# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
# https://supabase.com/docs/guides/self-hosting/docker#securing-your-services
# In this version of the template they are generated randomly by dokploy helpers
# so you do not need to change them manually
# Go to https://supabase.com/docs/guides/self-hosting for more information
############

SUPABASE_HOST=baseloop-supabase-157594-46-225-65-136.traefik.me
POSTGRES_PASSWORD=6qklgla0ubr7x1o4l8qd78qworiw1ogd
JWT_SECRET=xpwwxxphud0sqz7kpizofepibmaappo7
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3NzA1MjkxNTMsImV4cCI6MTg5MzQ1NjAwMCwicm9sZSI6ImFub24iLCJpc3MiOiJzdXBhYmFzZSJ9.1dHguKNjeSTTid15pZRGuqDjsp4Qa-zFEotPC0JUOVc
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3NzA1MjkxNTMsImV4cCI6MTg5MzQ1NjAwMCwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlzcyI6InN1cGFiYXNlIn0.T5-oK054IveFj4mlcIRH8Wst7Vrg93pPtGP2jBfHL8g
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=xr0vzy6xdbubdzlhn6np8revhjsr83gg
SECRET_KEY_BASE=pypqtbako4an1duc77lgqblqcdwirrbpjcuiyh23uaagoznz7oafqooqtfq6xlx4
VAULT_ENC_KEY=3eh9vgli8kypxki7f3q8r878w8d79tsy
PG_META_CRYPTO_KEY=kv4wmgbzrn7q2t8x5p1j0c6y9f3h8u2a


############
# Database - You can change these to any PostgreSQL database that has logical replication enabled.
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# default user is postgres


############
# PostgreSQL Tuning (Hetzner CCX33: 8 vCPU, 32GB RAM, NVMe SSD)
# These are passed as -c flags to postgres via the compose command
############

## Memory
PG_SHARED_BUFFERS=6GB
PG_EFFECTIVE_CACHE_SIZE=18GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=1536MB
PG_AUTOVACUUM_WORK_MEM=256MB

## WAL & Checkpoints
PG_WAL_BUFFERS=16MB
PG_CHECKPOINT_COMPLETION=0.9
PG_MIN_WAL_SIZE=2GB
PG_MAX_WAL_SIZE=8GB

## NVMe SSD Optimization
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_MAINTENANCE_IO_CONCURRENCY=200

## Connections
PG_MAX_CONNECTIONS=500

## Parallelism (tuned for 8 vCPU)
PG_MAX_WORKER_PROCESSES=8
PG_MAX_PARALLEL_WORKERS=8
PG_MAX_PARALLEL_WORKERS_PER_GATHER=4
PG_MAX_PARALLEL_MAINTENANCE_WORKERS=4

## Misc
PG_HUGE_PAGES=try
PG_DEFAULT_STATISTICS_TARGET=100


############
# Supavisor -- Database pooler (optimized for 2000 connections)
# 300 backend pool connections, 2000 max client connections
# Transaction mode for Prisma + Trigger.dev bursty workloads
############
POOLER_SESSION_PORT=5433
POOLER_PROXY_PORT_TRANSACTION=6544
POOLER_DEFAULT_POOL_SIZE=300
POOLER_MAX_CLIENT_CONN=2000
POOLER_TENANT_ID=baseloop-prod
# Internal metadata pool for Supavisor (NOT the client-facing pool)
POOLER_DB_POOL_SIZE=5

############
# Supavisor Performance Tuning
############
# Kill idle client connections after 5 min (default: 0 = never)
# Prisma creates connections on demand, so stale ones waste client slots
POOLER_CLIENT_IDLE_TIMEOUT=300000
# Detect dead connections faster (default: 60s)
POOLER_CLIENT_HEARTBEAT_INTERVAL=30
# Fail fast if pool is exhausted (default: 60s)
# 10s is enough for burst queuing; longer = Prisma hangs uselessly
POOLER_POOL_CHECKOUT_TIMEOUT=10000

############
# Direct DB access (for Prisma migrations)
############
POSTGRES_DIRECT_PORT=5435


############
# Internal Service DB Pools (explicit connection budget)
# These count against PG max_connections=500
# Budget: 300 (supavisor) + 15 (rest) + 15 (auth) + ~60 (other services) + ~110 headroom
############
PGRST_DB_POOL=15
PGRST_DB_POOL_TIMEOUT=10
GOTRUE_DB_POOL=15


############
# API Proxy - Configuration for the Kong Reverse proxy.
# Following ports should not be changed for a dokploy config unless you know what you are doing.
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


############
# API - Configuration for PostgREST.
############

PGRST_DB_SCHEMAS=public,storage,graphql_public


############
# Auth - Configuration for the GoTrue authentication server.
############

## General
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://baseloop-supabase-157594-46-225-65-136.traefik.me/*,http://localhost:3000/*
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://baseloop-supabase-157594-46-225-65-136.traefik.me

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true


############
# Realtime Scaling (500 concurrent target, 1000 ceiling)
# Supports both Broadcast and Postgres Changes with RLS
# Note: RLS bottleneck -- each DB change triggers 1 RLS check per subscriber
############
RT_MAX_CONCURRENT_USERS=1000
RT_MAX_EVENTS_PER_SECOND=2500
RT_MAX_JOINS_PER_SECOND=500
RT_MAX_BYTES_PER_SECOND=500000
REALTIME_DB_ENC_KEY=2f39ce8f8bc449c3


############
# Studio - Configuration for the Dashboard
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

STUDIO_PORT=3000
# replace if you intend to use Studio outside of localhost
SUPABASE_PUBLIC_URL=http://baseloop-supabase-157594-46-225-65-136.traefik.me

# Enable webp support
IMGPROXY_AUTO_WEBP=true

# Add your OpenAI API key to enable SQL Editor Assistant
OPENAI_API_KEY=


############
# Logs - Configuration for Logflare
# Please refer to https://supabase.com/docs/reference/self-hosting-analytics/introduction
############

LOGFLARE_LOGGER_BACKEND_API_KEY=your-super-secret-and-long-logflare-key

# Logflare access tokens (replaces LOGFLARE_API_KEY)
# Public token: used by Vector and services to send logs
LOGFLARE_PUBLIC_ACCESS_TOKEN=u3isitddjap8eqohcoztmkz5mfecbhya
# Private token: used by Studio for admin analytics queries
LOGFLARE_PRIVATE_ACCESS_TOKEN=u3isitddjap8eqohcoztmkz5mfecbhya

# Docker socket location - this value will differ depending on your OS
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Google Cloud Project details
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER


############
# Storage
############
# Max upload file size in bytes (1GB = 1073741824)
FILE_SIZE_LIMIT=1073741824


############
# Docker Log Rotation
############
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
